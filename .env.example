# Postgres 凭据。compose 里 db 容器用它初始化，app/fetcher/api 通过 libpq 变量连库。
POSTGRES_USER=fx
POSTGRES_PASSWORD=fx-dev-password
POSTGRES_DB=fx

# 宿主机映射端口（容器内固定 5432）。端口只在这里定义一次：
# compose 的 db.ports 用它，下面的 FX_DSN 引用它，改这一处即可。
# 选 5436 是因为 config.py 的 DEFAULT_DSN 打的就是它，且本机 5432 常被别的库占用。
POSTGRES_PORT=5436

# 连接 URL，本机直连用。容器内不生效：compose 固定注入 FX_DSN="host=db port=5432"。
# ${POSTGRES_PORT} 由 shell 在 source 时展开，端口不会和上面写重。
# 代码只读 os.environ、不读 .env，本机需先导出：
#     set -a; source .env; set +a
# 不导出也能跑：config.py 的 DEFAULT_DSN 与本值相同。
FX_DSN=postgresql://fx:fx-dev-password@127.0.0.1:${POSTGRES_PORT}/fx

# 宿主机端口与绑定地址。同机反代用 127.0.0.1；由外部客户端直连时改成 0.0.0.0。
# 默认 8766，避免与 hscode 服务的 8765 冲突。
FX_PORT=8766
FX_BIND_HOST=127.0.0.1
# REST API 端口（fx-api）。默认 8767，与 MCP 的 8766 分开。
FX_API_PORT=8767
FX_API_BIND_HOST=127.0.0.1

# 每日抓取时刻（容器时区 Asia/Shanghai）。CFETS 约 09:15 发布当日中间价。
FX_FETCH_AT=09:40
# 请求间隔秒数。按月分页后请求数很少，1.5 秒足够；调大只是更保守。
FX_FETCH_DELAY=1.5
# 历史回填起点。历史接口有限流，区间越长请求越多；3 年足够覆盖报关追溯场景。
FX_BACKFILL_START=2023-01-01

# 市场参考汇率（exchangerate-api.com）的 key。可选：不配则只抓 CFETS 中间价，
# /api/market-rate 会返回「暂无数据」。市场价不是计征汇率，只做参考。
FX_EXCHANGERATE_API_KEY=

# /api/health 的数据滞后阈值（天）。
# 中间价超阈值只告警（休市本来就不更新）；市场参考汇率超阈值判故障（返回 503）。
FX_STALE_WARN_DAYS=7
FX_MARKET_STALE_DAYS=2

# 构建软件源（Dockerfile 的 ARG PYPI_INDEX_URL ← compose 的 args）。
# 国内用阿里云，实测约 0.5s，比 pypi.org 的 4s 快 4 倍；清华 tuna 当前 403 不可用。
# 境外机器改回 https://pypi.org/simple
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
