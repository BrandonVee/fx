    "/api/latest": {
      "get": {
        "tags": [
          "中间价"
        ],
        "summary": "最近一个交易日公布的中间价（当前价）",
        "description": "最近一个交易日公布的中间价（「当前价」）。\n\n中间价每个交易日约 09:15 公布一次，休市日不更新——所以返回里带 rate_date\n与 stale_days（距今天数）。这是中间价而非实时行情，也不能用于报关折算。",
        "operationId": "latest_api_latest_get",
        "parameters": [
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "外币币种，代码或中文名；留空返回全部币种",
              "title": "Currency"
            },
