    "/api/market-rate": {
      "get": {
        "tags": [
          "市场参考汇率"
        ],
        "summary": "市场参考汇率（非计征汇率，不可报关）",
        "description": "市场参考汇率（**非计征汇率，不可用于报关折算**）。\n\n境外源，每日 UTC 00:00 更新，周末与节假日照常更新，覆盖约 160 个币种——\n包括 CFETS 不公布的冷门币种。与 /api/latest（CFETS 中间价）是两个口径，\n返回里的 cfets_reference 给出同币种中间价与偏离，便于交叉核对。",
        "operationId": "market_rate_api_market_rate_get",
        "parameters": [
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "外币币种代码（如 VND）或中文名；留空返回全部",
              "title": "Currency"
            },
            "description": "外币币种代码（如 VND）或中文名；留空返回全部"
